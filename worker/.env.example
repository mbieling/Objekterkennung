# Neon PostgreSQL — direkte Connection-URL (NICHT Pooler-URL)
# Für psycopg2 muss Session-Mode verwendet werden, nicht der Neon-Connection-Pooler.
# Fundort: Neon Dashboard > Project > Connection Details > "Direct connection"
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# AWS S3 — für STEP-Dateien (parts-steps) und Thumbnails (parts-thumbnails)
# Fundort: AWS IAM > Users > Security credentials > Create access key
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# S3-Bucket-Namen (müssen mit Phase 1 übereinstimmen)
AWS_S3_BUCKET_STEPS=parts-steps
AWS_S3_BUCKET_THUMBNAILS=parts-thumbnails

# ─── Phase 3: Celery + Redis Queue ───────────────────────────────────────────

# Celery Broker URL — Redis-Verbindung für Task-Queue
# Lokal mit Docker Compose: redis://redis:6379/0 (internes Docker-Netzwerk)
# Lokal ohne Docker (Upstash Dev): rediss://:{PASSWORD}@{HOST}:{PORT}
# Produktion (Upstash): rediss://:{PASSWORD}@{HOST}:{PORT}?ssl_cert_reqs=required
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend — normalerweise gleiche URL wie Broker
# Speichert Task-Status (PENDING, STARTED, SUCCESS, FAILURE)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Hugging Face Token (für DINOv3-Zugriff) ─────────────────────────────────
# DINOv3 ist nicht offen herunterladbar — der HF-Nutzer muss einmalig auf
# https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m die Privacy
# Policy bestätigen. Anschließend einen Read-Only-Token unter
# https://huggingface.co/settings/tokens generieren und hier eintragen.
# Wird zur Laufzeit von transformers automatisch verwendet.
HF_TOKEN=hf_your_read_only_token_here
