# Neon PostgreSQL
# Fundort: Neon Dashboard > Project > Connection Details > Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# AWS S3 — für STEP-Dateien (parts-steps) und Thumbnails (parts-thumbnails)
# Fundort: AWS IAM > Users > Security credentials > Create access key
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET_STEPS=parts-steps
AWS_S3_BUCKET_THUMBNAILS=parts-thumbnails

# Admin-Bereich (Katalog + schreibende Part-APIs) — HTTP Basic Auth
# Wird in src/middleware.ts geprüft. Wenn die Variable fehlt, ist /admin gesperrt (fail-closed).
ADMIN_PASSWORD=change_me

# Add more environment variables as needed
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# ─── Phase 3: Ingestion API + Queue ──────────────────────────────────────────

# Python Worker — URL des FastAPI-Endpunkts (POST /enqueue, GET /health)
# Lokal ohne Docker: starte Worker mit: cd worker && uvicorn main:app --port 8000
# Lokal mit Docker Compose: http://localhost:8000 (Port-Mapping in docker-compose.yml)
# Produktion: https://your-worker.railway.app (Railway / Fly.io URL)
WORKER_URL=http://localhost:8000

# Upstash Redis — nur für Produktion oder wenn kein lokaler Docker läuft
# Fundort: Upstash Console > Redis > Connect > Celery
# Format: rediss://:{PASSWORD}@{HOST}:{PORT} (rediss:// = TLS-Pflicht bei Upstash)
# Lokal mit Docker Compose: nicht nötig (Worker nutzt redis://redis:6379/0 intern)
UPSTASH_REDIS_URL=rediss://:your_upstash_password@your-host.upstash.io:6379
